# Auth (NextAuth / Auth.js v5)
# Production (Vercel): set AUTH_URL to your public site URL, e.g.
#   AUTH_URL=https://makerstudios-docs.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
AUTH_SECRET=

# Google Cloud Console (OAuth client):
#   Authorized JavaScript origins → https://makerstudios-docs.vercel.app
#   Authorized redirect URIs     → https://makerstudios-docs.vercel.app/api/auth/callback/google
# Note: path must end with /google (not /api/auth/callback alone).

# MongoDB
MONGODB_URI=

# xAI — server-only (import .md / .txt → HTML)
XAI_API_KEY=
# Text model (default grok-3-latest)
XAI_MODEL=
# Vision model when importing with images (default grok-2-vision-1212)
XAI_VISION_MODEL=

# Upload server (avatars / icons)
NEXT_PUBLIC_UPLOAD_SERVER_URL=
NEXT_PUBLIC_UPLOAD_SERVER_KEY=
